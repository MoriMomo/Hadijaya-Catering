# Environment Configuration Example
# Copy this file to .env.local and fill in actual values
# DO NOT commit .env.local to version control!

# WhatsApp Business API (if needed in future)
# VITE_WHATSAPP_API_KEY=your_api_key_here
# VITE_WHATSAPP_PHONE_ID=your_phone_id_here

# Third-party services
# VITE_STRIPE_PUBLIC_KEY=pk_test_...
# VITE_SENDGRID_API_KEY=SG.xxx...

# Analytics and Monitoring
# VITE_SENTRY_DSN=https://xxx@xxx.ingest.sentry.io/xxx

# API Endpoints
# VITE_API_URL=https://api.example.com
# VITE_API_TIMEOUT=30000

# Application Environment
VITE_APP_ENV=development # development | production

# Supabase Configuration
VITE_SUPABASE_URL=your-supabase-url.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-keym
